{
  "manifest_version": 3,
  "name": "GenASL — Interpreter Avatar for YouTube",
  "version": "5.0.0",
  "description": "Generates a 3D ASL interpreter avatar overlay on YouTube videos via a local AI pipeline (in build-out — see docs/plan/).",
  "permissions": ["storage", "activeTab"],
  "host_permissions": ["https://www.youtube.com/*", "http://127.0.0.1:8794/*"],
  "icons": {
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icons/icon48.png"
  },
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
